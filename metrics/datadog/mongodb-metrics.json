{
  "title": "Indexer :: MongoDB Metrics",
  "description": "Incremental build to test MongoDB metrics",
  "widgets": [
    {
      "id": 1,
      "definition": {
        "title": "Connection Pool Size",
        "title_size": "16",
        "title_align": "left",
        "type": "query_value",
        "requests": [
          {
            "response_format": "scalar",
            "queries": [
              {
                "data_source": "metrics",
                "name": "query1",
                "query": "avg:mongodb.driver.pool.size{indexer-id:$indexer-id.value}",
                "aggregator": "avg"
              }
            ],
            "formulas": [
              {
                "formula": "query1"
              }
            ]
          }
        ],
        "autoscale": true,
        "precision": 2
      },
      "layout": {
        "x": 0,
        "y": 0,
        "width": 4,
        "height": 2
      }
    },
    {
      "id": 2,
      "definition": {
        "title": "Connection Pool Over Time",
        "title_size": "16",
        "title_align": "left",
        "show_legend": true,
        "legend_layout": "auto",
        "legend_columns": [
          "avg",
          "min",
          "max",
          "value",
          "sum"
        ],
        "type": "timeseries",
        "requests": [
          {
            "response_format": "timeseries",
            "queries": [
              {
                "data_source": "metrics",
                "name": "query1",
                "query": "avg:mongodb.driver.pool.size{indexer-id:$indexer-id.value}"
              },
              {
                "data_source": "metrics",
                "name": "query2",
                "query": "avg:mongodb.driver.pool.checkedout{indexer-id:$indexer-id.value}"
              }
            ],
            "formulas": [
              {
                "alias": "Pool Size",
                "formula": "query1"
              },
              {
                "alias": "Checked Out",
                "formula": "query2"
              }
            ],
            "style": {
              "palette": "dog_classic",
              "line_type": "solid",
              "line_width": "normal"
            },
            "display_type": "line"
          }
        ]
      },
      "layout": {
        "x": 4,
        "y": 0,
        "width": 8,
        "height": 2
      }
    },
    {
