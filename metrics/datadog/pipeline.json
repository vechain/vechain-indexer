{
  "filter": {
    "query": "source:elb (name:prod-green-main-api-veworld-alb OR name:prod-blue-main-api-veworld-alb OR name:prod-green-test-api-veworld-alb OR name:prod-blue-test-api-veworld-alb)"
  },
  "id": "uW-eeiofTRm3QAUSOMKvFA",
  "is_enabled": true,
  "is_read_only": false,
  "name": "AWS ELB Access Veworld",
  "processors": [
    {
      "grok": {
        "match_rules": "elb.http %{_date_access} %{_elb_name}\\s+(?:%{_client_ip}:%{_client_port}|-) (?:%{_destination_ip}:%{_destination_port}|-) (?>-1|%{_request_processing_time}) (?>-1|%{_backend_processing_time}) (?>-1|%{_reponse_processing_time}) (?:%{_status_code}|-) (?:%{_backend_status_code}|-) %{_bytes_read} %{_bytes_written}\\s+\"(?>%{_method} |- )%{_url}(?> %{_version}| -\\s*)\" \"%{_user_agent}\" %{_ssl_cipher} %{_ssl_protocol}( %{_arn} %{_requestID})?\n\nalb %{_http_protocol} %{elb.http}.*\n",
        "support_rules": "_elb_name %{notSpace:elb.name}\n_http_protocol %{word:http.protocol}\n_backend_status_code %{integer:elb.backend_status_code}\n_request_processing_time %{number:elb.performance.request_processing_time:scale(1000)}\n_backend_processing_time %{number:elb.performance.backend_processing_time:scale(1000)}\n_reponse_processing_time %{number:elb.performance.response_processing_time:scale(1000)}\n_ssl_cipher %{notSpace:http.ssl.cipher:nullIf(\"-\")}\n_ssl_protocol %{notSpace:http.ssl.protocol:nullIf(\"-\")}\n_bytes_written %{integer:network.bytes_written}\n_bytes_read %{integer:network.bytes_read}\n_client_ip %{ipOrHost:network.client.ip}\n_client_port %{integer:network.client.port}\n_destination_ip %{ipOrHost:network.destination.ip}\n_destination_port %{integer:network.destination.port}\n_duration %{number:duration:scale(1000000)}\n_version HTTP\\/%{regex(\"\\\\d+\\\\.\\\\d+\"):http.version}\n_url %{notSpace:http.url:nullIf(\"-\")}\n_user_agent %{regex(\"[^\\\\\\\"]*\"):http.useragent:nullIf(\"-\")}\n_status_code %{integer:http.status_code}\n_method %{word:http.method}\n_date_access %{date(\"yyyy-MM-dd'T'HH:mm:ss.SSSSSSZ\"):date_access}\n_arn %{notSpace:aws.arn}\n_requestID \"Root\\=%{notSpace:TraceId}\"\n"
      },
      "is_enabled": true,
      "name": "Parsing ELB access logs",
      "samples": [
        "2015-05-13T23:39:43.945958Z my-loadbalancer 192.168.131.39:2817 10.0.0.1:80 0.000073 0.001048 0.000057 200 200 0 29 \"GET http://www.example.com:80/ HTTP/1.1\" \"curl/7.38.0\" - -",
        "2015-05-13T23:39:43.945958Z my-loadbalancer 192.168.131.39:2817 10.0.0.1:80 0.000086 0.001048 0.001337 200 200 0 57 \"GET https://www.example.com:443/ HTTP/1.1\" \"curl/7.38.0\" DHE-RSA-AES128-SHA TLSv1.2",
        "2015-05-13T23:39:43.945958Z my-loadbalancer 192.168.131.39:2817 10.0.0.1:80 0.001069 0.000028 0.000041 - - 82 305 \"- - - \" \"-\" - -",
        "2015-05-13T23:39:43.945958Z my-loadbalancer 192.168.131.39:2817 10.0.0.1:80 0.001065 0.000015 0.000023 - - 57 502 \"- - - \" \"-\" ECDHE-ECDSA-AES128-GCM-SHA256 TLSv1.2"
      ],
      "source": "message",
      "type": "grok-parser"
    },
