{
  "title": "Indexer :: JVM Metrics",
  "description": "JVM performance metrics including memory, threads, and garbage collection",
  "widgets": [
    {
      "id": 1,
      "definition": {
        "title": "Heap Usage %",
        "title_size": "16",
        "title_align": "left",
        "type": "query_value",
        "requests": [
          {
            "formulas": [
              {
                "formula": "100 * query1 / query2"
              }
            ],
            "queries": [
              {
                "data_source": "metrics",
                "name": "query1",
                "query": "avg:jvm.memory.used{area:heap , indexer-id:$indexer-id.value}",
                "aggregator": "last"
              },
              {
                "data_source": "metrics",
                "name": "query2",
                "query": "avg:jvm.memory.max{area:heap ,indexer-id:$indexer-id.value}",
                "aggregator": "last"
              }
            ],
            "response_format": "scalar"
          }
        ],
        "autoscale": true,
        "precision": 1
      },
      "layout": {
        "x": 0,
        "y": 0,
        "width": 3,
        "height": 2
      }
    },
