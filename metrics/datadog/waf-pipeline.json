{
  "filter": {
    "query": "source:cloudwatch host:aws-waf-logs-*"
  },
  "is_enabled": true,
  "name": "Veworld WAF Request Logs",
  "processors": [
    {
      "is_enabled": true,
      "name": "Extract project ID header",
      "operation": {
        "filter": "name:x-project-id",
        "source": "httpRequest.headers",
        "target": "project_id",
        "type": "select",
        "value_to_extract": "value"
      },
      "type": "array-processor"
    },
    {
      "categories": [
        {
          "filter": {
            "query": "-@project_id:*"
          },
          "name": "unknown"
        }
      ],
      "is_enabled": true,
      "name": "Backfill missing project ID",
      "target": "project_id",
      "type": "category-processor"
    }
  ],
  "tags": [],
  "type": "pipeline"
}
