{
  "filter": {
    "query": "source:cloudwatch host:aws-waf-logs-*"
  },
  "is_enabled": true,
  "name": "Veworld WAF Request Logs",
  "processors": [
    {
      "categories": [
        {
          "filter": {
            "query": "@httpSourceId:*prod-blue-main-api-veworld-alb*"
          },
          "name": "prod-blue-main"
        },
        {
          "filter": {
            "query": "@httpSourceId:*prod-green-main-api-veworld-alb*"
          },
          "name": "prod-green-main"
        },
        {
          "filter": {
            "query": "@httpSourceId:*prod-blue-test-api-veworld-alb*"
          },
          "name": "prod-blue-test"
        },
        {
          "filter": {
            "query": "@httpSourceId:*prod-green-test-api-veworld-alb*"
          },
          "name": "prod-green-test"
        }
      ],
      "is_enabled": true,
      "name": "Map ALB to deployment scope",
      "target": "deployment_scope",
      "type": "category-processor"
    },
    {
      "is_enabled": true,
      "name": "Extract project ID header (canonical case)",
      "operation": {
        "filter": "name:\"X-Project-Id\"",
        "source": "httpRequest.headers",
        "target": "project_id",
        "type": "select",
        "value_to_extract": "value"
      },
      "type": "array-processor"
    },
    {
      "is_enabled": true,
      "name": "Extract project ID header (lowercase)",
      "operation": {
        "filter": "name:\"x-project-id\"",
        "source": "httpRequest.headers",
        "target": "project_id",
        "type": "select",
        "value_to_extract": "value"
      },
      "type": "array-processor"
    },
    {
      "categories": [
        {
          "filter": {
            "query": "-@project_id:*"
          },
          "name": "unknown"
        }
      ],
      "is_enabled": true,
      "name": "Backfill missing project ID",
      "target": "project_id",
      "type": "category-processor"
    },
    {
      "categories": [
        {
