{
  "parameters": {
    "page": [
      0,
      3
    ],
    "size": [
      20,
      150
    ],
    "direction": [
      "DESC"
    ],
    "expanded": [
      true,
      false
    ]
  },
  "path_overrides": {
    "/api/v1/transactions/count": {
      "ignore_paths": [
        "root.totalTransactions",
        "root.totalClauses",
        "root.totalRevertedTransactions",
        "root.totalRevertedClauses"
      ]
    },
    "/api/v1/transactions/latest": {},
    "/api/v1/transfers/latest": {},
    "/api/v1/transactions": {
      "direction": [
        "ASC",
        "DESC"
      ]
    },
    "/api/v1/transactions/contract": {
      "direction": [
        "ASC",
        "DESC"
      ]
    },
    "/api/v1/transactions/delegated": {
      "direction": [
        "ASC",
        "DESC"
      ]
    },
    "/api/v1/accounts/overview/{address}": {
      "ignore_paths": [
        "root.lastSeen",
        "root.transactionsSent",
        "root.clausesSent",
        "root.vthoBurned",
        "root.gasUsed",
        "root.vetSent",
        "root.vetReceived",
        "root.vetBalance",
        "root.vthoBlockRewards",
        "root.vthoPassiveGeneration",
        "root.vthoClaimedStargate",
        "root.vthoEarnedTotal"
      ]
    },
    "/api/v1/b3tr/richlist": {
      "ignore_paths": [
        "root.data[*].balance",
        "root.data[*].rank"
      ]
    },
    "/api/v1/b3tr/richlist/{address}": {
      "ignore_paths": [
        "root.balance",
        "root.rank",
        "root.totalHolders",
        "root.topPercentage"
      ]
    },
    "/api/v2/validators/{validatorId}": {
      "ignore_paths": [
        "root.blockProbability",
        "root.blocksPerYear",
        "root.blocksPerEpoch",
        "root.completedPeriods",
        "root.scheduledSlots",
        "root.proposedBlocks",
        "root.missedSlots",
        "root.missedSlotsPercentage",
        "root.lastProposedBlockNumber",
        "root.lastMissedBlockNumber",
        "root.validatorLockedWeight",
        "root.totalNextPeriodWeight",
        "root.totalWeight"
      ]
    },
    "/api/v1/stargate/total-vtho-claimed/historic/{range}": {
      "range": [
        "1-week"
      ]
    },
    "/api/v1/stargate/total-vet-staked/historic/{range}": {
      "range": [
        "1-week"
      ]
    },
    "/api/v1/stargate/total-vtho-generated/historic/{range}": {
      "range": [
        "1-week"
      ]
    },
    "/api/v1/stargate/nft-holders/historic/{range}": {
      "range": [
        "1-week"
      ]
    },
    "/api/v1/history/{account}": {
      "eventName": [
        "TRANSFER_FT"
      ]
    },
    "/api/v2/history/{account}": {
      "eventName": [
        "TRANSFER_FT"
      ]
    },
    "/api/v1/stargate/tokens/{tokenId}/history": {
      "eventName": [
        "STARGATE_CLAIM_REWARDS"
      ]
    },
    "/api/v1/nfts/history": {
      "eventName": [
        "TRANSFER_NFT"
      ]
    },
    "/api/v1/b3tr/treasury/transfers": {
      "category": [
        "EMISSION",
        "GRANT"
      ]
    },
    "/api/v1/transfers": {
      "eventType": [
        "VET"
      ]
    },
    "/api/v1/transfers/to": {
      "eventType": [
        "VET"
      ]
    },
    "/api/v1/transfers/from": {
      "eventType": [
        "VET"
      ]
    },
    "/api/v1/validators": {
      "status": [
        "ACTIVE",
        "QUEUED",
        "EXITING",
        "EXITED"
      ],
      "endorser": null,
      "validatorId": null,
      "ignore_paths": [
        "root.data[*].blockProbability",
        "root.data[*].blocksPerEpoch",
        "root.data[*].blocksPerYear",
        "root.data[*].completedPeriods",
        "root.data[*].offlineBlocks",
        "root.data[*].percentageOffline",
        "root.data[*].online",
        "root.data[*].tvlBasedYield",
        "root.data[*].validatorYield",
        "root.data[*].avgDelegatorYield",
        "root.data[*].nextCycleAvgDelegatorYield",
        "root.data[*].nextCycleTvlBasedYield",
        "root.data[*].nextCycleValidatorYield",
        "root.data[*].nftYields",
        "root.data[*].nftYieldsIfDelegatedNextCycle"
      ]
    },
    "/api/v2/validators": {
      "endorser": null,
      "ignore_paths": [
        "root.data[*].blockProbability",
        "root.data[*].blocksPerYear",
        "root.data[*].blocksPerEpoch",
        "root.data[*].completedPeriods",
        "root.data[*].scheduledSlots",
        "root.data[*].proposedBlocks",
        "root.data[*].missedSlots",
        "root.data[*].missedSlotsPercentage",
        "root.data[*].lastProposedBlockNumber",
        "root.data[*].lastMissedBlockNumber",
        "root.data[*].validatorLockedWeight",
        "root.data[*].totalNextPeriodWeight",
        "root.data[*].totalWeight"
      ]
    },
    "/api/v1/validators/delegations": {
      "tokenId": null
    },
    "/api/v1/validators/block-rewards/{blockNumber}": {
      "validator": null
    },
    "/api/v1/validators/blocks/missed": {
      "ignore_paths": [
        "root.startBlock",
        "root.endBlock",
        "root.validators"
      ]
    },
    "/api/v1/validators/blocks/historic/{validator}": {},
    "/api/v1/vevote/proposals/comments": {
      "expect_fail": "Only the candidate serves this endpoint; v1 predates it"
    },
    "/api/v1/status": {
      "expect_fail": "Only the candidate serves this; it reads a Postgres table"
    }
  }
}
