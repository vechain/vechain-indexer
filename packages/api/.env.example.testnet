# Copy this file to .env to use testnet configuration.

SPRING_PROFILES_ACTIVE=nfts,blocks,transfers,history,vevote,vevote-historic,stargate,b3tr,explorer,validator,accounts,contracts,safe

# Mongo
MONGO_URI=mongodb://api:password@mongo-node1:27017/vechain?authSource=admin

# PostgreSQL
PG_URL=jdbc:postgresql://vechain-postgres:5432/vechain
PG_USER=api
PG_PASSWORD=password

# Thor
THOR_URL=https://testnet.vechain.org
# Optional in local dev. In deployed envs the value is injected from the secret store.
# THOR_RATE_LIMIT_BYPASS_KEY=

# Price feed oracle (vechain.energy PriceFeedOracle).
# Must be set explicitly for testnet — application.yaml defaults to the mainnet oracle, so leaving
# these unset silently quotes mainnet VET/VTHO prices against testnet stake.
PRICE_ORACLE_THOR_URL=https://testnet.vechain.org
PRICE_ORACLE_CONTRACT=0xdcCAaBd81B38e0dEEf4c202bC7F1261A4D9192C6

# B3TR Contract Addresses
X_ALLOC_VOTING_CONTRACT=0x8800592c463f0b21ae08732559ee8e146db1d7b2
CHALLENGES_CONTRACT=0x9529916b152357e7e2990c3ce4fe5373d7da54bc

# Logging
APP_LOG_LEVEL=INFO
TIMING_WARN_THRESHOLD_MS=1000
TIMING_VERY_SLOW_THRESHOLD_MS=10000

# Cache Configuration
# Global defaults for all caches (applied when cache-specific values not set)
CACHE_MAX_SIZE=1000
CACHE_TTL_SECONDS=3600

# Cache-specific overrides (optional - uncomment and set to override global defaults)
# B3TR action rank caches
#CACHE_B3TR_ACTION_RANK_COUNTS_MAX_SIZE=12000
#CACHE_B3TR_ACTION_RANK_COUNTS_TTL_SECONDS=300

# Official token addresses cache (smaller size since only one network result is cached)
CACHE_OFFICIAL_TOKEN_ADDRESSES_MAX_SIZE=10
CACHE_OFFICIAL_TOKEN_ADDRESSES_TTL_SECONDS=3600

# GM NFT cache
#CACHE_GM_NFT_COUNT_MAX_SIZE=1000
#CACHE_GM_NFT_COUNT_TTL_SECONDS=3600

# B3TR richlist cache
#CACHE_B3TR_RICHLIST_TOTAL_HOLDERS_MAX_SIZE=10
#CACHE_B3TR_RICHLIST_TOTAL_HOLDERS_TTL_SECONDS=300

APP_VERSION=v.4.8.0

PROMETHEUS_METRICS_ENABLED=false
