# Copy this file to .env to use mainnet configuration.

SPRING_PROFILES_ACTIVE=nfts,transactions,transfers,history,vevote-results,vevote-historic-proposals,stargate,b3tr,explorer,validator,accounts,contracts

# Mongo
MONGO_URI=mongodb://api:password@mongo-node1:27017/vechain?authSource=admin

# Postgres
POSTGRES_URL=jdbc:postgresql://postgres:5432/vechain
POSTGRES_USER=vechain
POSTGRES_PASSWORD=password
SQL_INIT_MODE=always

# Thor
THOR_URL=https://mainnet.vechain.org

# B3TR Contract Addresses
X_ALLOC_VOTING_CONTRACT=0x89a00bb0947a30ff95beef77a66aede3842fe5b7
CHALLENGES_CONTRACT=0x68669db619977e56f604386146694520c896528e

# Logging
APP_LOG_LEVEL=INFO
TIMING_WARN_THRESHOLD_MS=1000

# Cache Configuration
# Global defaults for all caches (applied when cache-specific values not set)
CACHE_MAX_SIZE=1000
CACHE_TTL_SECONDS=3600

# Cache-specific overrides (optional - uncomment and set to override global defaults)
# User all-time action caches
#CACHE_USER_ALL_TIME_COUNT_BY_ENTITY_TYPE_MAX_SIZE=1000
#CACHE_USER_ALL_TIME_COUNT_BY_ENTITY_TYPE_TTL_SECONDS=3600
#CACHE_USER_ALL_TIME_COUNT_BY_TOTAL_REWARD_MAX_SIZE=1000
#CACHE_USER_ALL_TIME_COUNT_BY_TOTAL_REWARD_TTL_SECONDS=3600
#CACHE_USER_ALL_TIME_COUNT_BY_ACTIONS_MAX_SIZE=1000
#CACHE_USER_ALL_TIME_COUNT_BY_ACTIONS_TTL_SECONDS=3600

# App all-time action caches
#CACHE_APP_ALL_TIME_COUNT_BY_APP_ID_MAX_SIZE=1000
#CACHE_APP_ALL_TIME_COUNT_BY_APP_ID_TTL_SECONDS=3600
#CACHE_APP_ALL_TIME_COUNT_BY_TOTAL_REWARD_MAX_SIZE=1000
#CACHE_APP_ALL_TIME_COUNT_BY_TOTAL_REWARD_TTL_SECONDS=3600
#CACHE_APP_ALL_TIME_COUNT_BY_ACTIONS_MAX_SIZE=1000
#CACHE_APP_ALL_TIME_COUNT_BY_ACTIONS_TTL_SECONDS=3600

# App daily action caches
#CACHE_APP_DAILY_COUNT_MAX_SIZE=1000
#CACHE_APP_DAILY_COUNT_TTL_SECONDS=3600
#CACHE_APP_DAILY_COUNT_BY_TOTAL_REWARD_MAX_SIZE=1000
#CACHE_APP_DAILY_COUNT_BY_TOTAL_REWARD_TTL_SECONDS=3600
#CACHE_APP_DAILY_COUNT_BY_ACTIONS_MAX_SIZE=1000
#CACHE_APP_DAILY_COUNT_BY_ACTIONS_TTL_SECONDS=3600

# App round action caches
#CACHE_APP_ROUND_COUNT_MAX_SIZE=1000
#CACHE_APP_ROUND_COUNT_TTL_SECONDS=3600
#CACHE_APP_ROUND_COUNT_BY_TOTAL_REWARD_MAX_SIZE=1000
#CACHE_APP_ROUND_COUNT_BY_TOTAL_REWARD_TTL_SECONDS=3600
#CACHE_APP_ROUND_COUNT_BY_ACTIONS_MAX_SIZE=1000
#CACHE_APP_ROUND_COUNT_BY_ACTIONS_TTL_SECONDS=3600

# User daily action caches
#CACHE_USER_DAILY_COUNT_BY_TOTAL_REWARD_MAX_SIZE=1000
#CACHE_USER_DAILY_COUNT_BY_TOTAL_REWARD_TTL_SECONDS=3600
#CACHE_USER_DAILY_COUNT_BY_ACTIONS_MAX_SIZE=1000
#CACHE_USER_DAILY_COUNT_BY_ACTIONS_TTL_SECONDS=3600
#CACHE_USER_DAILY_COUNT_BY_ENTITY_TYPE_MAX_SIZE=1000
#CACHE_USER_DAILY_COUNT_BY_ENTITY_TYPE_TTL_SECONDS=3600

# User round action caches
#CACHE_USER_ROUND_COUNT_BY_TOTAL_REWARD_MAX_SIZE=1000
#CACHE_USER_ROUND_COUNT_BY_TOTAL_REWARD_TTL_SECONDS=3600
#CACHE_USER_ROUND_COUNT_BY_ACTIONS_MAX_SIZE=1000
#CACHE_USER_ROUND_COUNT_BY_ACTIONS_TTL_SECONDS=3600
#CACHE_USER_ROUND_COUNT_BY_ENTITY_TYPE_MAX_SIZE=1000
#CACHE_USER_ROUND_COUNT_BY_ENTITY_TYPE_TTL_SECONDS=3600

# Official token addresses cache (smaller size since only one network result is cached)
CACHE_OFFICIAL_TOKEN_ADDRESSES_MAX_SIZE=10
CACHE_OFFICIAL_TOKEN_ADDRESSES_TTL_SECONDS=3600

# GM NFT cache
#CACHE_GM_NFT_COUNT_MAX_SIZE=1000
#CACHE_GM_NFT_COUNT_TTL_SECONDS=3600

# B3TR richlist cache
#CACHE_B3TR_RICHLIST_TOTAL_HOLDERS_MAX_SIZE=10
#CACHE_B3TR_RICHLIST_TOTAL_HOLDERS_TTL_SECONDS=300

APP_VERSION=v.4.8.0
