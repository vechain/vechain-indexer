# These variables are dockerised. Copy this file to .env and change the values to your needs.

SPRING_PROFILES_ACTIVE=nfts,transactions,transfers,history,stargate,authority-nodes,vevote-results,vevote-historic-proposals,b3tr,explorer

# Mongo
MONGO_URI=mongodb://api:password@mongo-node1:27017/vechain?authSource=admin

# Token Registry
TOKEN_REGISTRY_URL=https://vechain.github.io/token-registry

# Thor
THOR_URL=https://mainnet.vechain.org

# Logging
APP_LOG_LEVEL=INFO
TIMING_WARN_THRESHOLD_MS=1000

# Cache Configuration
# Global defaults for all caches (applied when cache-specific values not set)
CACHE_MAX_SIZE=1000
CACHE_TTL_SECONDS=3600

# Cache-specific overrides (optional - uncomment and set to override global defaults)
# User all-time action caches
#CACHE_USER_ALL_TIME_COUNT_BY_ENTITY_TYPE_MAX_SIZE=1000
#CACHE_USER_ALL_TIME_COUNT_BY_ENTITY_TYPE_TTL_SECONDS=3600
#CACHE_USER_ALL_TIME_COUNT_BY_REWARD_MAX_SIZE=1000
#CACHE_USER_ALL_TIME_COUNT_BY_REWARD_TTL_SECONDS=3600
#CACHE_USER_ALL_TIME_COUNT_BY_ACTIONS_MAX_SIZE=1000
#CACHE_USER_ALL_TIME_COUNT_BY_ACTIONS_TTL_SECONDS=3600

# App all-time action caches
#CACHE_APP_ALL_TIME_COUNT_BY_APP_ID_MAX_SIZE=1000
#CACHE_APP_ALL_TIME_COUNT_BY_APP_ID_TTL_SECONDS=3600

# App daily action caches
#CACHE_APP_DAILY_COUNT_MAX_SIZE=1000
#CACHE_APP_DAILY_COUNT_TTL_SECONDS=3600

# App round action caches
#CACHE_APP_ROUND_COUNT_MAX_SIZE=1000
#CACHE_APP_ROUND_COUNT_TTL_SECONDS=3600

# User daily action caches
#CACHE_USER_DAILY_COUNT_MAX_SIZE=1000
#CACHE_USER_DAILY_COUNT_TTL_SECONDS=3600
#CACHE_USER_DAILY_COUNT_BY_ACTIONS_MAX_SIZE=1000
#CACHE_USER_DAILY_COUNT_BY_ACTIONS_TTL_SECONDS=3600
#CACHE_USER_DAILY_COUNT_BY_ENTITY_TYPE_MAX_SIZE=1000
#CACHE_USER_DAILY_COUNT_BY_ENTITY_TYPE_TTL_SECONDS=3600

# User round action caches
#CACHE_USER_ROUND_COUNT_BY_REWARD_MAX_SIZE=1000
#CACHE_USER_ROUND_COUNT_BY_REWARD_TTL_SECONDS=3600
#CACHE_USER_ROUND_COUNT_BY_ACTIONS_MAX_SIZE=1000
#CACHE_USER_ROUND_COUNT_BY_ACTIONS_TTL_SECONDS=3600
#CACHE_USER_ROUND_COUNT_BY_ENTITY_TYPE_MAX_SIZE=1000
#CACHE_USER_ROUND_COUNT_BY_ENTITY_TYPE_TTL_SECONDS=3600

# Official token addresses cache (smaller size since only one network result is cached)
CACHE_OFFICIAL_TOKEN_ADDRESSES_MAX_SIZE=10
CACHE_OFFICIAL_TOKEN_ADDRESSES_TTL_SECONDS=3600

# GM NFT cache
#CACHE_GM_NFT_COUNT_MAX_SIZE=1000
#CACHE_GM_NFT_COUNT_TTL_SECONDS=3600
