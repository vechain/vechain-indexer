# These variables are dockerised. Copy this file to .env and change the values to your needs.
SERVER_ADDRESS=0.0.0.0
SPRING_PROFILES_ACTIVE=nfts,blocks,transfers,history,e2e

# Mongo
MONGO_URI=mongodb://api:password@mongo-node1:27017/vechain?authSource=admin

# PostgreSQL
PG_URL=jdbc:postgresql://vechain-postgres:5432/vechain
PG_USER=api
PG_PASSWORD=password

THOR_URL=http://thor-solo:8669

APP_LOG_LEVEL=INFO
TIMING_WARN_THRESHOLD_MS=1000
