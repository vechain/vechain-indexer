# These variables are dockerised. Copy this file to .env and change the values to your needs.
SERVER_ADDRESS=0.0.0.0
SPRING_PROFILES_ACTIVE=nfts,transactions,transfers,history,e2e

# Mongo
MONGO_URI=mongodb://api:password@mongo-node1:27017/vechain?authSource=admin

# Postgres
POSTGRES_URL=jdbc:postgresql://postgres:5432/vechain
POSTGRES_USER=vechain
POSTGRES_PASSWORD=password
SQL_INIT_MODE=always

# Token Registry
TOKEN_REGISTRY_URL=https://vechain.github.io/token-registry

THOR_URL=http://thor-solo:8669

APP_LOG_LEVEL=INFO
TIMING_WARN_THRESHOLD_MS=1000
