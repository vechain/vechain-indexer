# These variables are dockerised. Copy this file to .env and change the values to your needs.
SERVER_ADDRESS=0.0.0.0
SPRING_PROFILES_ACTIVE=indexer,nfts,transactions,transfers,history

# Mongo
MONGO_URI=mongodb://indexer:password@mongo-node1:27017/vechain?authSource=admin

# Thor
THOR_URL=http://thor-solo:8669

# Start blocks - defaults
INDEXER_START_BLOCK_BLOCKS=0
INDEXER_START_BLOCK_CONTRACTS=1
INDEXER_START_BLOCK_CLAUSES=0
INDEXER_START_BLOCK_NFTS=0
INDEXER_START_BLOCK_NFT_BLACKLIST=0
INDEXER_START_BLOCK_TRANSFERS=0
INDEXER_START_BLOCK_TRANSACTIONS=0
INDEXER_START_BLOCK_HISTORY=0

# Pruner
PRUNER_INTERVAL=3000
PRUNER_REMOVAL_CHUNK_SIZE=10000

# Logs Block Indexer
INDEXER_SYNC_BLOCK_BATCH_SIZE_NFTS=100
INDEXER_SYNC_BLOCK_BATCH_SIZE_TRANSFERS=100

APP_LOG_LEVEL=INFO
