{
  "name": "B3TR_ActionReward",
  "sameClause": true,
  "events": [
    {
      "name": "Transfer",
      "alias": "transferB3TR",
      "conditions": [
        {
          "firstOperand": "from",
          "isFirstStatic": false,
          "secondOperand": "${X2EARN_REWARDS_POOL_CONTRACT}",
          "isSecondStatic": true,
          "operator": "EQ"
        },
        {
          "firstOperand": "address",
          "isFirstStatic": false,
          "secondOperand": "${B3TR_CONTRACT}",
          "isSecondStatic": true,
          "operator": "EQ"
        }
      ]
    },
    {
      "name": "RewardDistributed",
      "alias": "actionReward",
      "conditions": [
        {
          "firstOperand": "address",
          "isFirstStatic": false,
          "secondOperand": "${X2EARN_REWARDS_POOL_CONTRACT}",
          "isSecondStatic": true,
          "operator": "EQ"
        }
      ]
    }
  ],
  "rules": [
    {
      "firstEventName": "transferB3TR",
      "firstEventProperty": "value",
      "secondEventName": "actionReward",
      "secondEventProperty": "amount",
      "operator": "EQ"
    }
  ],
  "paramsDefinition": [
    {
      "name": "amount",
      "eventName": "actionReward",
      "businessEventName": "amount"
    },
    {
      "name": "appId",
      "eventName": "actionReward",
      "businessEventName": "appId"
    },
    {
      "name": "proof",
      "eventName": "actionReward",
      "businessEventName": "proof"
    },
    {
      "name": "distributor",
      "eventName": "actionReward",
      "businessEventName": "distributor"
    },
    {
      "name": "receiver",
      "eventName": "actionReward",
      "businessEventName": "receiver"
    }
  ]
}
