{
  "name": "B3TR_GmUpgrade",
  "sameClause": true,
  "events": [
    {
      "name": "Upgraded",
      "alias": "upgradeEvent",
      "conditions": [
        {
          "firstOperand": "address",
          "isFirstStatic": false,
          "secondOperand": "${GM_NFT_CONTRACT}",
          "isSecondStatic": true,
          "operator": "EQ"
        },
        {
          "firstOperand": "tokenId",
          "isFirstStatic": false,
          "secondOperand": "0",
          "isSecondStatic": true,
          "operator": "GE"
        }
      ]
    },
    {
      "name": "Transfer",
      "alias": "transferB3TR",
      "conditions": [
        {
          "firstOperand": "address",
          "isFirstStatic": false,
          "secondOperand": "${B3TR_CONTRACT}",
          "isSecondStatic": true,
          "operator": "EQ"
        },
        {
          "firstOperand": "value",
          "isFirstStatic": false,
          "secondOperand": "0",
          "isSecondStatic": true,
          "operator": "GT"
        },
        {
          "firstOperand": "to",
          "isFirstStatic": false,
          "secondOperand": "${TREASURY_CONTRACT}",
          "isSecondStatic": true,
          "operator": "EQ"
        }
      ]
    }
  ],
  "rules": [],
  "paramsDefinition": [
    {
      "name": "tokenId",
      "eventName": "upgradeEvent",
      "businessEventName": "tokenId"
    },
    {
      "name": "from",
      "eventName": "transferB3TR",
      "businessEventName": "from"
    },
    {
      "name": "address",
      "eventName": "transferB3TR",
      "businessEventName": "to"
    },
    {
      "name": "oldLevel",
      "eventName": "upgradeEvent",
      "businessEventName": "oldLevel"
    },
    {
      "name": "newLevel",
      "eventName": "upgradeEvent",
      "businessEventName": "newLevel"
    },
    {
      "name": "value",
      "eventName": "transferB3TR",
      "businessEventName": "value"
    }
  ]
}
