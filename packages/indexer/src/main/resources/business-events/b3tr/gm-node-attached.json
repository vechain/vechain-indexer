{
  "name": "B3TR_GmNodeAttached",
  "sameClause": true,
  "events": [
    {
      "name": "NodeAttached",
      "alias": "linkEvent",
      "conditions": [
        {
          "firstOperand": "address",
          "isFirstStatic": false,
          "secondOperand": "${GM_NFT_CONTRACT}",
          "isSecondStatic": true,
          "operator": "EQ"
        }
      ]
    },
    {
      "name": "LevelWhenAttached",
      "alias": "levelEvent",
      "conditions": [
        {
          "firstOperand": "address",
          "isFirstStatic": false,
          "secondOperand": "${GM_NFT_CONTRACT}",
          "isSecondStatic": true,
          "operator": "EQ"
        }
      ]
    }
  ],
  "rules": [
    {
      "firstEventName": "linkEvent",
      "firstEventProperty": "nodeTokenId",
      "secondEventName": "levelEvent",
      "secondEventProperty": "nodeTokenId",
      "operator": "EQ"
    },
    {
      "firstEventName": "linkEvent",
      "firstEventProperty": "tokenId",
      "secondEventName": "levelEvent",
      "secondEventProperty": "tokenId",
      "operator": "EQ"
    }
  ],
  "paramsDefinition": [
    {
      "name": "tokenId",
      "eventName": "levelEvent",
      "businessEventName": "tokenId"
    },
    {
      "name": "nodeTokenId",
      "eventName": "levelEvent",
      "businessEventName": "nodeTokenId"
    },
    {
      "name": "level",
      "eventName": "levelEvent",
      "businessEventName": "level"
    }
  ]
}
