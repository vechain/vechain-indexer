{
  "name": "STARGATE_DELEGATE_REQUEST_CANCELLED",
  "sameClause": true,
  "events": [
    {
      "name": "DelegationExitRequested",
      "alias": "exitRequest",
      "conditions": [
        {
          "firstOperand": "tokenId",
          "isFirstStatic": false,
          "secondOperand": 0,
          "isSecondStatic": true,
          "operator": "GT"
        },
        {
          "firstOperand": "address",
          "isFirstStatic": false,
          "secondOperand": "${STARGATE_CONTRACT}",
          "isSecondStatic": true,
          "operator": "EQ"
        }
      ]
    },
    {
      "name": "DelegationWithdrawn",
      "alias": "withdraw",
      "conditions": [
        {
          "firstOperand": "tokenId",
          "isFirstStatic": false,
          "secondOperand": 0,
          "isSecondStatic": true,
          "operator": "GT"
        },
        {
          "firstOperand": "address",
          "isFirstStatic": false,
          "secondOperand": "${STARGATE_CONTRACT}",
          "isSecondStatic": true,
          "operator": "EQ"
        }
      ]
    }
  ],
  "rules": [
    {
      "firstEventName": "exitRequest",
      "firstEventProperty": "tokenId",
      "secondEventName": "withdraw",
      "secondEventProperty": "tokenId",
      "operator": "EQ"
    }
  ],
  "paramsDefinition": [
    {
      "name": "tokenId",
      "eventName": "withdraw",
      "businessEventName": "tokenId"
    },
    {
      "name": "validator",
      "eventName": "withdraw",
      "businessEventName": "validator"
    },
    {
      "name": "delegationId",
      "eventName": "withdraw",
      "businessEventName": "delegationId"
    },
    {
      "name": "origin",
      "eventName": "withdraw",
      "businessEventName": "owner"
    },
    {
      "name": "amount",
      "eventName": "withdraw",
      "businessEventName": "value"
    },
    {
      "name": "levelId",
      "eventName": "withdraw",
      "businessEventName": "levelId"
    }
  ]
}