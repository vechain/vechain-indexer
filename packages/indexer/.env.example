# These variables are dockerised. Copy this file to .env and change the values to your needs.

SPRING_PROFILES_ACTIVE=indexer,nft-events,clauses,blocks,contracts,transactions,transfer-events,history-events

# Mongo
MONGO_URI=mongodb://indexer:password@mongo-node1:27017/vechain?authSource=admin

# Thor
THOR_URL=http://thor-solo:8669

# Start blocks - defaults
INDEXER_START_BLOCK_BLOCKS=0
INDEXER_START_BLOCK_CONTRACTS=1
INDEXER_START_BLOCK_CLAUSES=0
INDEXER_START_BLOCK_NFTS=0
INDEXER_START_BLOCK_NFT_BLACKLIST=0
INDEXER_START_BLOCK_TRANSFERS=0
INDEXER_START_BLOCK_TRANSACTIONS=0
INDEXER_START_BLOCK_HISTORY=0

# Start blocks - MAINNET
#INDEXER_START_BLOCK_BLOCKS=0
#INDEXER_START_BLOCK_CONTRACTS=409987
#INDEXER_START_BLOCK_CLAUSES=751
#INDEXER_START_BLOCK_NFTS=1304112
#INDEXER_START_BLOCK_NFT_BLACKLIST=21245914
#INDEXER_START_BLOCK_TRANSFERS=37840
#INDEXER_START_BLOCK_TRANSACTIONS=751
#INDEXER_START_BLOCK_HISTORY=751

# Start blocks - TESTNET
#INDEXER_START_BLOCK_BLOCKS=0
#INDEXER_START_BLOCK_CONTRACTS=15101
#INDEXER_START_BLOCK_CLAUSES=15034
#INDEXER_START_BLOCK_NFTS=1042259
#INDEXER_START_BLOCK_NFT_BLACKLIST=21294907
#INDEXER_START_BLOCK_TRANSFERS=15034
#INDEXER_START_BLOCK_TRANSACTIONS=15034
#INDEXER_START_BLOCK_HISTORY=15034

# Contracts (Mainnet)
CONTRACT_NFT_BLACKLIST=0x14091CC9Ae249f26EaF41a5A21207931162A2826

# Contracts (Testnet)
#CONTRACT_NFT_BLACKLIST=0x07310cECa66aD36A0dc02A142dF28B81a653107E

# Pruner
PRUNER_ENABLED=true
PRUNER_INTERVAL=300000
PRUNER_INITIAL_DELAY=300000
PRUNER_REMOVAL_CHUNK_SIZE=10000

# Logs Block Indexer
INDEXER_SYNC_BLOCK_BATCH_SIZE_NFTS=100
INDEXER_SYNC_BLOCK_BATCH_SIZE_TRANSFERS=100

APP_LOG_LEVEL=INFO
