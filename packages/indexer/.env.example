# These variables are dockerised. Copy this file to .env and change the values to your needs.

SPRING_PROFILES_ACTIVE=indexer,nfts,transactions,transfers,history,stargate,b3tr

# Mongo
MONGO_URI=mongodb://indexer:password@mongo-node1:27017/vechain?authSource=admin

# Thor
THOR_URL=https://mainnet.vechain.org

# Start blocks - MAINNET
INDEXER_START_BLOCK_NFTS=1304112
INDEXER_START_BLOCK_NFT_BLACKLIST=21774168
INDEXER_START_BLOCK_TRANSFERS=37840
INDEXER_START_BLOCK_TRANSACTIONS=751
INDEXER_START_BLOCK_HISTORY=751
