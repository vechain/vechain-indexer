# These variables are dockerised. Copy this file to .env and change the values to your needs.

SPRING_PROFILES_ACTIVE=indexer,nft-events,transactions,transfer-events,history-events

# Mongo
MONGO_URI=mongodb://indexer:password@mongo-node1:27017/vechain?authSource=admin

# Thor
THOR_URL=https://mainnet.vechain.org

# Start blocks - MAINNET
INDEXER_START_BLOCK_NFTS=1304112
INDEXER_START_BLOCK_NFT_BLACKLIST=21774168
INDEXER_START_BLOCK_TRANSFERS=37840
INDEXER_START_BLOCK_TRANSACTIONS=751
INDEXER_START_BLOCK_HISTORY=751

# Start blocks - TESTNET
#INDEXER_START_BLOCK_NFTS=1042259
#INDEXER_START_BLOCK_NFT_BLACKLIST=21823565
#INDEXER_START_BLOCK_TRANSFERS=15034
#INDEXER_START_BLOCK_TRANSACTIONS=15034
#INDEXER_START_BLOCK_HISTORY=15034

# Pruner
PRUNER_ENABLED=true
PRUNER_INTERVAL=300000
PRUNER_INITIAL_DELAY=300000
PRUNER_REMOVAL_CHUNK_SIZE=10000

# Blacklist
BLACKLIST_INTERVAL=1800000
BLACKLIST_INITIAL_DELAY=60000
## Mainnet
BLACKLIST_CONTRACT_ADDRESS=0x0f9b01618cd5e0030f8e26ff61bc1349cb9eb8d5
## Testnet
#BLACKLIST_CONTRACT_ADDRESS=0x9405c18c384dd448f82c11136e188a147186ea3a

# Logs Block Indexer
INDEXER_SYNC_BLOCK_BATCH_SIZE_NFTS=100
INDEXER_SYNC_BLOCK_BATCH_SIZE_TRANSFERS=100

APP_LOG_LEVEL=INFO

# Indexer Version
VERSION_NFTS=1
VERSION_TRANSFERS=1
VERSION_TRANSACTIONS=1
VERSION_HISTORY=1
VERSION_NFT_BLACKLIST=2

# B3TR Contract Addresses (Mainnet)
B3TR_CONTRACT=0x5ef79995fe8a89e0812330e4378eb2660cede699
VOT3_CONTRACT=0x76ca782b59c74d088c7d2cce2f211bc00836c602
B3TR_GOVERNOR_CONTRACT=0x1c65c25fabe2fc1bcb82f253fa0c916a322f777c
GM_NFT_CONTRACT=0x93b8cd34a7fc4f53271b9011161f7a2b5fea9d1f
X_ALLOC_VOTING_CONTRACT=0x89a00bb0947a30ff95beef77a66aede3842fe5b7
X2EARN_REWARDS_POOL_CONTRACT=0x6bee7ddab6c99d5b2af0554eaea484ce18f52631
VOTER_REWARDS_CONTRACT=0x838a33af756a6366f93e201423e1425f67ec0fa7
