# MongoDB restore presets for ./restore.sh
#
# Copy this file to `.env` (gitignored) and fill in the URIs you need.
# restore.sh auto-sources `.env` at startup.
#
# Each preset is an environment variable named MONGO_PRESET_<NAME>. The
# wrapper lists them as menu options for source and destination selection.
#
# URIs that omit the password (mongodb://user@host/db) trigger a single
# hidden prompt at run time. URIs with the password embedded are used as-is.
# The wrapper never writes URIs or passwords back to disk.

# --- Sources ---
export MONGO_PRESET_LOCAL='mongodb://root:password@localhost:27017/vechain?authSource=admin'
# export MONGO_PRESET_HOMELAB='mongodb://root:password@<lan-ip>:27017/vechain?authSource=admin'

# --- Destinations (Atlas) ---
# export MONGO_PRESET_GREEN_MAINNET='mongodb+srv://<user>@<cluster>.mongodb.net/vechain?retryWrites=true&w=majority'
# export MONGO_PRESET_GREEN_TESTNET='mongodb+srv://<user>@<cluster>.mongodb.net/vechain?retryWrites=true&w=majority'
# export MONGO_PRESET_BLUE_MAINNET='mongodb+srv://<user>@<cluster>.mongodb.net/vechain?retryWrites=true&w=majority'
# export MONGO_PRESET_BLUE_TESTNET='mongodb+srv://<user>@<cluster>.mongodb.net/vechain?retryWrites=true&w=majority'
