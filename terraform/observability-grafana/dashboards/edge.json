    {
      "id": 10,
      "type": "timeseries",
      "title": "CloudFront requests",
      "description": "AWS/CloudFront Requests (Sum) across the two distributions fronting indexer.mainnet.vechain.org (E15Q64MS368TL primary, E1LMOFNZTMWN6R spare/replica).",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 1 },
      "datasource": { "type": "cloudwatch", "uid": "cloudwatch" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "cloudwatch", "uid": "cloudwatch" },
          "namespace": "AWS/CloudFront",
          "metricName": "Requests",
          "statistic": "Sum",
          "dimensions": {
            "DistributionId": ["E15Q64MS368TL", "E1LMOFNZTMWN6R"],
            "Region": "Global"
          },
          "region": "us-east-1",
          "period": "60",
          "matchExact": true,
          "metricEditorMode": 0,
          "metricQueryType": 0,
          "label": "${PROP('Dim.DistributionId')}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 } },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["last", "mean", "max"] } }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Cache hit rate",
      "description": "AWS/CloudFront CacheHitRate (Average, %). Higher = more edge hits, less origin load. Indexer API is largely uncacheable so expect low double digits at best; drops toward zero on cache invalidation or hot-path change.",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 1 },
      "datasource": { "type": "cloudwatch", "uid": "cloudwatch" },
      "targets": [
        {
