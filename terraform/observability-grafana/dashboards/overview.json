{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "links": [
    {
      "type": "dashboards",
      "title": "Logs",
      "tags": ["logs"],
      "asDropdown": false,
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false,
      "icon": "external link",
      "tooltip": "Logs dashboard, carrying the current deployment/network selection and time range.",
      "url": ""
    }
  ],
  "refresh": "1m",
  "schemaVersion": 39,
  "tags": ["observability", "edge"],
  "time": { "from": "now-1h", "to": "now" },
  "timezone": "",
  "title": "Indexer, API & Edge",
  "uid": "overview",
  "templating": {
    "list": [
      {
        "name": "deployment",
        "label": "Deployment",
        "description": "Blue/green colour(s) to include. Multi-select; \"All\" covers both. Has no effect on the Edge row — CloudFront and WAF sit in front of both colours.",
        "type": "custom",
        "query": "blue,green",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "options": [
          { "text": "blue", "value": "blue", "selected": false },
          { "text": "green", "value": "green", "selected": false }
        ],
        "current": { "text": "All", "value": ["$__all"], "selected": true }
      },
      {
        "name": "network",
        "label": "Network",
        "description": "VeChain network(s) to include. Multi-select; defaults to main. Drives both the Prometheus panels (via the `network` label) and the CloudWatch Edge panels (via the hidden cf_distribution / waf_acl mapping variables).",
        "type": "custom",
        "query": "main,test",
        "multi": true,
        "includeAll": true,
        "allValue": "main|test",
        "options": [
          { "text": "main", "value": "main", "selected": true },
          { "text": "test", "value": "test", "selected": false }
        ],
        "current": { "text": "main", "value": ["main"], "selected": true }
      },
      {
        "name": "indexer_name",
        "label": "Indexer",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "amp" },
        "query": { "query": "label_values(indexer_current_block{deployment=~\"$deployment\", network=~\"$network\"}, indexer_name)", "refId": "indexer_name" },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*"
      },
      {
        "name": "filters",
        "label": "Filters",
        "description": "Ad-hoc label filters applied to every AMP (Prometheus) panel — uri, status, task_id, collection, command, endpoint, … Replaces the old URI textbox. Does not apply to the CloudWatch Edge row, which is a different datasource.",
        "type": "adhoc",
        "datasource": { "type": "prometheus", "uid": "amp" },
        "filters": []
      },
      {
        "name": "cf_distribution",
        "label": "CloudFront distributions",
        "description": "Hidden network→resource mapping. Options are `network:DistributionId` pairs; the regex keeps only the pairs whose prefix matches the selected network(s) and captures the id. main = E15Q64MS368TL (primary) + E1LMOFNZTMWN6R (spare); test = E1M1PCQ9GH0M5O (primary) + E2C4KPZEYCS5KZ (spare). These distributions are not managed by this repo's terraform, so the ids are hardcoded here.",
        "type": "custom",
        "hide": 2,
        "query": "main:E15Q64MS368TL,main:E1LMOFNZTMWN6R,test:E1M1PCQ9GH0M5O,test:E2C4KPZEYCS5KZ",
        "regex": "/^(?:${network:pipe}):(.*)$/",
        "multi": true,
        "includeAll": true,
        "current": { "text": "All", "value": ["$__all"], "selected": true }
      },
      {
        "name": "waf_acl",
        "label": "WAF WebACLs",
        "description": "Hidden network→resource mapping, same shape as cf_distribution. Note the naming is asymmetric — the mainnet ACL carries no network token — so the name cannot be derived from $network and has to be listed explicitly.",
        "type": "custom",
        "hide": 2,
        "query": "main:shared-veworld-cloudfront-waf,test:shared-veworld-testnet-cloudfront-waf",
        "regex": "/^(?:${network:pipe}):(.*)$/",
        "multi": true,
        "includeAll": true,
        "current": { "text": "All", "value": ["$__all"], "selected": true }
      }
    ]
  },
  "panels": [
    {
      "id": 9,
      "type": "row",
      "title": "Edge — CloudFront + WAF · shared, not blue/green scoped",
      "collapsed": true,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "panels": [
        {
          "id": 100,
          "type": "timeseries",
          "title": "CloudFront requests",
          "description": "AWS/CloudFront Requests (Sum) across the distributions fronting indexer.<network>.vechain.org, selected by $network via the hidden cf_distribution variable. $deployment does not apply — the edge fronts whichever colour DNS currently points at. CloudFront metrics are 1-minute granularity and publish with a few minutes of lag, so the right-hand edge of this panel trails the Prometheus panels below.",
          "gridPos": { "h": 8, "w": 8, "x": 0, "y": 1 },
          "datasource": { "type": "cloudwatch", "uid": "cloudwatch" },
          "targets": [
            {
              "refId": "A",
              "datasource": { "type": "cloudwatch", "uid": "cloudwatch" },
              "namespace": "AWS/CloudFront",
              "metricName": "Requests",
              "statistic": "Sum",
              "dimensions": {
                "DistributionId": ["$cf_distribution"],
                "Region": "Global"
              },
              "region": "us-east-1",
              "period": "60",
              "matchExact": true,
              "metricEditorMode": 0,
              "metricQueryType": 0,
              "label": "${PROP('Dim.DistributionId')}"
            }
          ],
          "fieldConfig": { "defaults": { "unit": "short", "min": 0 } },
          "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["last", "mean", "max"] } }
        },
        {
          "id": 101,
          "type": "timeseries",
          "title": "Cache hit rate",
          "description": "AWS/CloudFront CacheHitRate (Average, %) for the $network distributions. Higher = more edge hits, less origin load. The indexer API is largely uncacheable so expect low double digits at best; drops toward zero on cache invalidation or a hot-path change.",
          "gridPos": { "h": 8, "w": 8, "x": 8, "y": 1 },
          "datasource": { "type": "cloudwatch", "uid": "cloudwatch" },
          "targets": [
            {
              "refId": "A",
              "datasource": { "type": "cloudwatch", "uid": "cloudwatch" },
              "namespace": "AWS/CloudFront",
              "metricName": "CacheHitRate",
              "statistic": "Average",
              "dimensions": {
                "DistributionId": ["$cf_distribution"],
                "Region": "Global"
              },
              "region": "us-east-1",
              "period": "300",
              "matchExact": true,
              "metricEditorMode": 0,
              "metricQueryType": 0,
              "label": "${PROP('Dim.DistributionId')}"
            }
          ],
          "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 } },
          "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["last", "mean"] } }
        },
        {
          "id": 102,
          "type": "timeseries",
          "title": "CloudFront error rate — 4xx / 5xx",
          "description": "AWS/CloudFront 4xxErrorRate + 5xxErrorRate (Average, %) for the $network distributions — percentage of viewer requests returning 4xx/5xx at the edge. Cross-reference with the API 4xx/5xx panels in the Errors row: edge errors the origin never saw are WAF blocks or CloudFront-level failures.",
          "gridPos": { "h": 8, "w": 8, "x": 16, "y": 1 },
          "datasource": { "type": "cloudwatch", "uid": "cloudwatch" },
          "targets": [
            {
              "refId": "A",
              "datasource": { "type": "cloudwatch", "uid": "cloudwatch" },
              "namespace": "AWS/CloudFront",
              "metricName": "4xxErrorRate",
              "statistic": "Average",
              "dimensions": {
                "DistributionId": ["$cf_distribution"],
                "Region": "Global"
              },
              "region": "us-east-1",
              "period": "300",
              "matchExact": true,
              "metricEditorMode": 0,
              "metricQueryType": 0,
              "label": "4xx · ${PROP('Dim.DistributionId')}"
            },
            {
              "refId": "B",
              "datasource": { "type": "cloudwatch", "uid": "cloudwatch" },
              "namespace": "AWS/CloudFront",
              "metricName": "5xxErrorRate",
              "statistic": "Average",
              "dimensions": {
                "DistributionId": ["$cf_distribution"],
                "Region": "Global"
              },
              "region": "us-east-1",
              "period": "300",
              "matchExact": true,
              "metricEditorMode": 0,
              "metricQueryType": 0,
              "label": "5xx · ${PROP('Dim.DistributionId')}"
            }
          ],
          "fieldConfig": { "defaults": { "unit": "percent", "min": 0 } },
          "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["last", "mean", "max"] } }
        },
        {
          "id": 103,
          "type": "timeseries",
          "title": "WAF — allowed vs blocked",
          "description": "AWS/WAFV2 AllowedRequests + BlockedRequests (Sum, Rule=ALL) for the $network WebACL. Aggregate across the whole ACL. With both networks selected you get one Allowed and one Blocked series per ACL.",
          "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
          "datasource": { "type": "cloudwatch", "uid": "cloudwatch" },
          "targets": [
            {
              "refId": "A",
              "datasource": { "type": "cloudwatch", "uid": "cloudwatch" },
              "namespace": "AWS/WAFV2",
              "metricName": "AllowedRequests",
              "statistic": "Sum",
              "dimensions": {
                "WebACL": ["$waf_acl"],
                "Rule": "ALL"
              },
              "region": "us-east-1",
              "period": "60",
              "matchExact": true,
              "metricEditorMode": 0,
              "metricQueryType": 0,
              "label": "Allowed · ${PROP('Dim.WebACL')}"
            },
            {
              "refId": "B",
              "datasource": { "type": "cloudwatch", "uid": "cloudwatch" },
              "namespace": "AWS/WAFV2",
              "metricName": "BlockedRequests",
              "statistic": "Sum",
              "dimensions": {
                "WebACL": ["$waf_acl"],
                "Rule": "ALL"
              },
              "region": "us-east-1",
              "period": "60",
              "matchExact": true,
              "metricEditorMode": 0,
              "metricQueryType": 0,
              "label": "Blocked · ${PROP('Dim.WebACL')}"
            }
          ],
          "fieldConfig": {
            "defaults": { "unit": "short", "min": 0 },
            "overrides": [
              { "matcher": { "id": "byRegexp", "options": "/^Allowed/" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }] },
              { "matcher": { "id": "byRegexp", "options": "/^Blocked/" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] }
            ]
          },
          "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["last", "mean", "max"] } }
        },
        {
          "id": 104,
          "type": "timeseries",
          "title": "WAF — blocked requests by rule",
          "description": "AWS/WAFV2 BlockedRequests (Sum) for the $network WebACL, split by Rule. Rule = the CloudWatch metric name from VisibilityConfig.MetricName. The rule list is the union across both networks — testnet has no python-user-agent rate-limit rule, so that series is simply empty there. Spike hunters: rate-based rule (a customer being throttled), block-ip-set (specific IP blocked), block-get-options-swagger (non-GET/OPTIONS request rejected).",
          "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
          "datasource": { "type": "cloudwatch", "uid": "cloudwatch" },
          "targets": [
            {
              "refId": "A",
              "datasource": { "type": "cloudwatch", "uid": "cloudwatch" },
              "namespace": "AWS/WAFV2",
              "metricName": "BlockedRequests",
              "statistic": "Sum",
              "dimensions": {
                "WebACL": ["$waf_acl"],
                "Rule": [
                  "Imperva-Imperva-IP-Reputation",
                  "waf--custom-AWS-block-ip-set",
                  "waf--managed-AWS-AWSManagedRulesAmazonIpReputationList",
                  "waf--managed-AWS-AWSManagedRulesCommonRuleSet",
                  "waf--managed-AWS-AWSManagedRulesKnownBadInputsRuleSet",
                  "waf--managed-AWS-AWSManagedRulesSQLiRuleSet",
                  "waf--custom-AWS-AWS-Rate-Based-Rule",
                  "block-get-options-swagger",
                  "waf--custom-AWS-rate-limit-User-agent-python",
                  "waf--custom-AWS-block-health-check-endpoints"
                ]
              },
              "region": "us-east-1",
              "period": "60",
              "matchExact": true,
              "metricEditorMode": 0,
              "metricQueryType": 0,
              "label": "${PROP('Dim.Rule')}"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "short",
              "min": 0,
              "custom": {
                "fillOpacity": 30,
                "stacking": { "mode": "normal", "group": "A" }
              }
            }
          },
          "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["last", "mean", "max"] } }
        }
      ]
    },
    {
      "id": 1,
      "type": "row",
      "title": "Sync",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 1 },
      "panels": []
    },
    {
      "id": 10,
      "type": "piechart",
      "title": "Indexers by sync status",
      "description": "count by (status) of indexers where indexer_sync_status == 1. Deduped across task_id — deployment/network are kept in the inner max so a shared indexer_name across networks isn't collapsed — and constrained to the last 45s so post-deploy stale series drop out before the default 5m lookback.",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 2 },
      "datasource": { "type": "prometheus", "uid": "amp" },
      "targets": [
        {
          "refId": "A",
          "expr": "count by (status) (max by (indexer_name, status, deployment, network) (last_over_time(indexer_sync_status{deployment=~\"$deployment\", network=~\"$network\", indexer_name=~\"$indexer_name\", service=\"indexer\"}[45s])) == 1)",
          "legendFormat": "{{status}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": []
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "FULLY_SYNCED" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }] },
          { "matcher": { "id": "byName", "options": "SYNCING" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } }] },
          { "matcher": { "id": "byName", "options": "FAST_SYNCING" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "light-blue" } }] },
          { "matcher": { "id": "byName", "options": "READY_TO_SYNC" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "yellow" } }] },
          { "matcher": { "id": "byName", "options": "READY_TO_FAST_SYNC" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "yellow" } }] },
          { "matcher": { "id": "byName", "options": "NOT_INITIALISED" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }] },
          { "matcher": { "id": "byName", "options": "SHUT_DOWN" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] }
        ]
      },
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" },
        "pieType": "donut",
        "tooltip": { "mode": "single" },
        "legend": { "displayMode": "table", "placement": "right", "values": ["value", "percent"] },
        "displayLabels": ["name", "value"]
      }
    },
    {
      "id": 20,
      "type": "bargauge",
      "title": "Sync gap — blocks behind Thor best",
      "description": "max(thor_best) − max(indexer_current) per indexer, clamped to ≥ 0 and forced to 0 when the indexer reports FULLY_SYNCED (raw block-number diff can drift 1–3 blocks from sampling timing even when caught up). Bars sorted by gap desc, indexer name asc as tiebreaker; > 100 orange, > 500 red.",
      "gridPos": { "h": 8, "w": 16, "x": 8, "y": 2 },
      "datasource": { "type": "prometheus", "uid": "amp" },
      "targets": [
        {
          "refId": "A",
          "expr": "clamp_min((max by (deployment, network) (thor_best_block_number{deployment=~\"$deployment\", network=~\"$network\", service=\"indexer\"}) - on(deployment, network) group_right() max by (deployment, network, indexer_name) (indexer_current_block{deployment=~\"$deployment\", network=~\"$network\", indexer_name=~\"$indexer_name\", service=\"indexer\"})) * on(deployment, network, indexer_name) group_left() (1 - max by (deployment, network, indexer_name) (indexer_sync_status{deployment=~\"$deployment\", network=~\"$network\", indexer_name=~\"$indexer_name\", status=\"FULLY_SYNCED\", service=\"indexer\"})), 0)",
          "legendFormat": "{{indexer_name}} · {{deployment}}/{{network}}",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "reduce",
          "options": {
            "reducers": ["lastNotNull"],
            "mode": "seriesToRows",
            "includeTimeField": false
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [{ "field": "Field", "desc": false }]
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [{ "field": "Last *", "desc": true }]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 100 },
              { "color": "red", "value": 500 }
            ]
          },
          "color": { "mode": "thresholds" },
          "displayName": "${__data.fields.Field}"
        }
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "reduceOptions": { "values": true, "calcs": [], "fields": "" },
        "valueMode": "color"
      }
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Blocks / sec",
      "description": "rate(indexer_blocks_processed_total[1m]) per indexer.",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "amp" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (indexer_name) (rate(indexer_blocks_processed_total{deployment=~\"$deployment\", network=~\"$network\", indexer_name=~\"$indexer_name\"}[1m]))",
          "legendFormat": "{{indexer_name}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops", "min": 0 } },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["last", "mean", "max"] } }
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "Processor duration — p95",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "amp" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (indexer_name, le) (rate(processor_duration_seconds_bucket{deployment=~\"$deployment\", network=~\"$network\", indexer_name=~\"$indexer_name\"}[5m])))",
          "legendFormat": "{{indexer_name}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 } },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["last", "max"] } }
    },
    {
      "id": 23,
      "type": "timeseries",
      "title": "Thor client — p95 by endpoint",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "amp" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (endpoint, le) (rate(thor_client_request_duration_seconds_bucket{deployment=~\"$deployment\", network=~\"$network\"}[5m])))",
          "legendFormat": "{{endpoint}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 } },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["last", "max"] } }
    },
    {
      "id": 4,
      "type": "row",
      "title": "API",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "panels": []
    },
    {
      "id": 41,
      "type": "timeseries",
      "title": "Top URIs by rate",
      "description": "topk(10) of request rate by uri. Narrow to a single endpoint with the Filters bar at the top (uri = …).",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 19 },
      "datasource": { "type": "prometheus", "uid": "amp" },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by (uri) (rate(http_server_requests_seconds_count{deployment=~\"$deployment\", network=~\"$network\", service=\"api\"}[5m])))",
          "legendFormat": "{{uri}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0 } },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["last", "mean"] } }
    },
    {
      "id": 42,
      "type": "timeseries",
      "title": "API — avg latency by URI",
      "description": "rate(sum) / rate(count). Real p95 needs percentile histograms enabled server-side (management.metrics.distribution.percentiles-histogram.http.server.requests=true).",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 19 },
      "datasource": { "type": "prometheus", "uid": "amp" },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by (uri) (rate(http_server_requests_seconds_sum{deployment=~\"$deployment\", network=~\"$network\", service=\"api\"}[5m])) / sum by (uri) (rate(http_server_requests_seconds_count{deployment=~\"$deployment\", network=~\"$network\", service=\"api\"}[5m])))",
          "legendFormat": "{{uri}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 } },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["last", "max"] } }
    },
    {
      "id": 43,
      "type": "piechart",
      "title": "Requests by X-Project-Id",
      "description": "sum by (project) of api_requests_by_project_total increases over the dashboard time range. `unknown` = header missing; `other` = header set but not on the KNOWN_PROJECT_IDS whitelist (raw value logged); the rest are known callers.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 27 },
      "datasource": { "type": "prometheus", "uid": "amp" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (project) (increase(api_requests_by_project_total{service=\"api\", deployment=~\"$deployment\", network=~\"$network\"}[$__range]))",
          "legendFormat": "{{project}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "mappings": [] },
        "overrides": [
          { "matcher": { "id": "byName", "options": "unknown" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }] },
