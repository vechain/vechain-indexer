{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "links": [],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["observability", "indexer"],
  "time": { "from": "now-1h", "to": "now" },
  "timezone": "",
  "title": "Indexer — sync",
  "uid": "indexer-sync",
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "Env",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "amp" },
        "query": { "query": "label_values(indexer_current_block, env)", "refId": "env" },
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": false
      },
      {
        "name": "deployment",
        "label": "Deployment",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "amp" },
        "query": { "query": "label_values(indexer_current_block{env=~\"$env\"}, deployment)", "refId": "deployment" },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*"
      },
      {
        "name": "network",
        "label": "Network",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "amp" },
        "query": { "query": "label_values(indexer_current_block{env=~\"$env\", deployment=~\"$deployment\"}, network)", "refId": "network" },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*"
      },
      {
        "name": "indexer_name",
        "label": "Indexer",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "amp" },
        "query": { "query": "label_values(indexer_current_block{env=~\"$env\", deployment=~\"$deployment\", network=~\"$network\"}, indexer_name)", "refId": "indexer_name" },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Sync status",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "panels": []
    },
    {
      "id": 10,
      "type": "state-timeline",
      "title": "Sync status per indexer",
      "description": "One-hot indexer_sync_status. A cell = a (indexer_name, status) pair that is currently active (value = 1).",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "amp" },
      "targets": [
        {
          "refId": "A",
          "expr": "indexer_sync_status{env=~\"$env\", deployment=~\"$deployment\", network=~\"$network\", indexer_name=~\"$indexer_name\", service=\"indexer\"} == 1",
          "legendFormat": "{{indexer_name}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 70, "lineWidth": 0 },
          "mappings": [{ "type": "value", "options": { "1": { "text": "active", "color": "green" } } }]
        }
      },
      "options": {
        "mergeValues": true,
        "showValue": "auto",
        "alignValue": "left",
        "legend": { "displayMode": "list", "placement": "bottom" }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Current block vs Thor best",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "amp" },
      "targets": [
        {
          "refId": "A",
          "expr": "indexer_current_block{env=~\"$env\", deployment=~\"$deployment\", network=~\"$network\", indexer_name=~\"$indexer_name\"}",
          "legendFormat": "{{indexer_name}} — current"
        },
        {
          "refId": "B",
          "expr": "thor_best_block_number{env=~\"$env\", deployment=~\"$deployment\", network=~\"$network\"}",
          "legendFormat": "thor best"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["last", "max"] } }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Blocks / sec",
      "description": "rate(indexer_blocks_processed_total[1m]) per indexer.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "amp" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (indexer_name) (rate(indexer_blocks_processed_total{env=~\"$env\", deployment=~\"$deployment\", network=~\"$network\", indexer_name=~\"$indexer_name\"}[1m]))",
          "legendFormat": "{{indexer_name}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops", "min": 0 } },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["last", "mean", "max"] } }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Sync gap (blocks behind Thor best)",
      "description": "thor_best_block_number − indexer_current_block, joined per (task_id, deployment, network, service). Rises = falling behind.",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 17 },
      "datasource": { "type": "prometheus", "uid": "amp" },
      "targets": [
        {
          "refId": "A",
          "expr": "thor_best_block_number{env=~\"$env\", deployment=~\"$deployment\", network=~\"$network\"} - ignoring(indexer_name) group_right() indexer_current_block{env=~\"$env\", deployment=~\"$deployment\", network=~\"$network\", indexer_name=~\"$indexer_name\"}",
          "legendFormat": "{{indexer_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": { "thresholdsStyle": { "mode": "dashed" } },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 100 }
            ]
          }
        }
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["last", "max"] } }
    },
    {
      "id": 2,
      "type": "row",
      "title": "Processing",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 25 },
      "panels": []
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Processor duration — p95",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 26 },
      "datasource": { "type": "prometheus", "uid": "amp" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (indexer_name, le) (rate(processor_duration_seconds_bucket{env=~\"$env\", deployment=~\"$deployment\", network=~\"$network\", indexer_name=~\"$indexer_name\"}[5m])))",
          "legendFormat": "{{indexer_name}} p95"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 } },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["last", "max"] } }
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Thor client latency — p95 by endpoint",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 26 },
      "datasource": { "type": "prometheus", "uid": "amp" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (endpoint, le) (rate(thor_client_request_duration_seconds_bucket{env=~\"$env\", deployment=~\"$deployment\", network=~\"$network\"}[5m])))",
          "legendFormat": "{{endpoint}} p95"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 } },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["last", "max"] } }
    },
    {
      "id": 3,
      "type": "row",
      "title": "Errors",
      "collapsed": true,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 34 },
      "panels": [
        {
          "id": 30,
          "type": "timeseries",
          "title": "Thor client 5xx rate",
          "gridPos": { "h": 8, "w": 12, "x": 0, "y": 35 },
          "datasource": { "type": "prometheus", "uid": "amp" },
          "targets": [
            {
              "refId": "A",
              "expr": "sum by (endpoint, code) (rate(thor_client_response_codes_total{env=~\"$env\", deployment=~\"$deployment\", network=~\"$network\", code=~\"5..\"}[5m]))",
              "legendFormat": "{{endpoint}} {{code}}"
            }
          ],
          "fieldConfig": { "defaults": { "unit": "ops", "min": 0 } }
        },
        {
          "id": 31,
          "type": "timeseries",
          "title": "Thor client 4xx rate",
          "gridPos": { "h": 8, "w": 12, "x": 12, "y": 35 },
          "datasource": { "type": "prometheus", "uid": "amp" },
          "targets": [
            {
              "refId": "A",
              "expr": "sum by (endpoint, code) (rate(thor_client_response_codes_total{env=~\"$env\", deployment=~\"$deployment\", network=~\"$network\", code=~\"4..\"}[5m]))",
              "legendFormat": "{{endpoint}} {{code}}"
            }
          ],
          "fieldConfig": { "defaults": { "unit": "ops", "min": 0 } }
        }
      ]
    },
    {
      "id": 4,
      "type": "row",
      "title": "Resources",
      "collapsed": true,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 35 },
      "panels": [
        {
          "id": 40,
          "type": "timeseries",
          "title": "CPU utilised — per task",
          "description": "Task cgroup CPU / reserved × 100. Dashed line = 80%.",
          "gridPos": { "h": 8, "w": 12, "x": 0, "y": 36 },
          "datasource": { "type": "prometheus", "uid": "amp" },
          "targets": [
            {
              "refId": "A",
              "expr": "(ecs_task_cpu_utilized_None{env=~\"$env\", deployment=~\"$deployment\", network=~\"$network\", service=\"indexer\"} / ecs_task_cpu_reserved_None{env=~\"$env\", deployment=~\"$deployment\", network=~\"$network\", service=\"indexer\"}) * 100",
              "legendFormat": "{{task_id}}"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "percent",
              "min": 0,
              "max": 100,
              "custom": { "thresholdsStyle": { "mode": "dashed" } },
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  { "color": "green", "value": null },
                  { "color": "orange", "value": 80 }
                ]
              }
            }
          },
          "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["last", "max"] } }
        },
        {
          "id": 41,
          "type": "timeseries",
          "title": "Memory utilised — per task",
          "description": "Task cgroup RSS / reserved × 100. Dashed line = 80%.",
          "gridPos": { "h": 8, "w": 12, "x": 12, "y": 36 },
          "datasource": { "type": "prometheus", "uid": "amp" },
          "targets": [
            {
              "refId": "A",
              "expr": "(ecs_task_memory_utilized_Megabytes{env=~\"$env\", deployment=~\"$deployment\", network=~\"$network\", service=\"indexer\"} / ecs_task_memory_reserved_Megabytes{env=~\"$env\", deployment=~\"$deployment\", network=~\"$network\", service=\"indexer\"}) * 100",
              "legendFormat": "{{task_id}}"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "percent",
              "min": 0,
              "max": 100,
              "custom": { "thresholdsStyle": { "mode": "dashed" } },
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  { "color": "green", "value": null },
                  { "color": "orange", "value": 80 }
                ]
              }
            }
          },
          "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["last", "max"] } }
        }
      ]
    },
    {
      "id": 5,
      "type": "row",
      "title": "Health",
      "collapsed": true,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 36 },
      "panels": [
        {
          "id": 50,
          "type": "state-timeline",
          "title": "Component health",
          "description": "component_health_status: 1 UP, 0 DOWN, -1 UNKNOWN.",
          "gridPos": { "h": 8, "w": 24, "x": 0, "y": 37 },
          "datasource": { "type": "prometheus", "uid": "amp" },
          "targets": [
            {
              "refId": "A",
              "expr": "component_health_status{env=~\"$env\", deployment=~\"$deployment\", network=~\"$network\", service=\"indexer\"}",
              "legendFormat": "{{name}} ({{type}})"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "mappings": [
                { "type": "value", "options": { "1": { "text": "UP", "color": "green" } } },
                { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" } } },
                { "type": "value", "options": { "-1": { "text": "UNKNOWN", "color": "yellow" } } }
              ]
            }
          }
        }
      ]
    }
  ]
}
