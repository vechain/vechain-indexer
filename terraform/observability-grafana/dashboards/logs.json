{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 0,
  "links": [],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["observability", "logs"],
  "time": { "from": "now-1h", "to": "now" },
  "timezone": "browser",
  "title": "Logs",
  "uid": "logs",
  "templating": {
    "list": [
      {
        "name": "deployment",
        "label": "Deployment",
        "description": "Blue/green colour(s) to include. Multi-select; \"All\" covers both.",
        "type": "custom",
        "query": "blue,green",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "options": [
          { "text": "blue", "value": "blue", "selected": false },
          { "text": "green", "value": "green", "selected": false }
        ],
        "current": { "text": "All", "value": ["$__all"], "selected": true }
      },
      {
        "name": "service",
        "label": "Service",
        "description": "ECS service(s) to include. Multi-select; \"All\" covers every service.",
        "type": "custom",
        "query": "api,indexer",
        "multi": true,
        "includeAll": true,
        "allValue": "api|indexer",
        "options": [
          { "text": "api", "value": "api", "selected": false },
          { "text": "indexer", "value": "indexer", "selected": false }
        ],
        "current": { "text": "All", "value": ["$__all"], "selected": true }
      },
      {
        "name": "level",
        "label": "Level",
        "description": "Log level(s). Defaults to ERROR + WARN. Values match the LogstashEncoder `level` field.",
        "type": "custom",
        "query": "ERROR,WARN,INFO,DEBUG,TRACE",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "options": [
          { "text": "ERROR", "value": "ERROR", "selected": true },
          { "text": "WARN", "value": "WARN", "selected": true },
          { "text": "INFO", "value": "INFO", "selected": false },
          { "text": "DEBUG", "value": "DEBUG", "selected": false },
          { "text": "TRACE", "value": "TRACE", "selected": false }
        ],
        "current": {
          "text": ["ERROR", "WARN"],
          "value": ["ERROR", "WARN"],
          "selected": true
        }
      },
      {
        "name": "filter",
        "label": "Filter (regex, case-insensitive)",
        "description": "Free-text regex applied to `message` and `stack_trace`.",
        "type": "textbox",
        "current": { "text": "", "value": "" },
        "query": ""
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "logs",
      "title": "Logs — $service · $level",
      "description": "Single view over every ECS service log group. @message is placed first in `fields` so Grafana's Logs panel picks it as the log body; `level` and `logger_name` (parsed from the LogstashEncoder JSON) surface as labels. Deployment/service narrow via @log regex; level via the parsed field; filter regex runs against message and stack_trace.",
      "gridPos": { "h": 30, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "cloudwatch", "uid": "cloudwatch" },
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "queryMode": "Logs",
          "region": "default",
          "logGroupNames": [
            "veworld-prod-blue-main-api",
            "veworld-prod-blue-test-api",
            "veworld-prod-green-main-api",
            "veworld-prod-green-test-api",
            "veworld-prod-blue-main-indexer",
            "veworld-prod-blue-test-indexer",
            "veworld-prod-green-main-indexer",
            "veworld-prod-green-test-indexer"
          ],
          "expression": "fields @timestamp, @message, level, logger_name\n| filter @log like /prod-(${deployment:pipe})-/\n| filter @log like /-(${service:pipe})$/\n| filter level like /${level:pipe}/\n| filter (message like /(?i)${filter:raw}/) or (stack_trace like /(?i)${filter:raw}/)\n| sort @timestamp desc, @ptr desc\n| limit 500"
        }
      ]
    }
  ]
}
