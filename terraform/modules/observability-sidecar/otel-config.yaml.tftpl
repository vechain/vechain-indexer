extensions:
  sigv4auth:
    region: ${aws_region}
    service: aps
  health_check:
    endpoint: 0.0.0.0:13133

receivers:
  prometheus:
    config:
      scrape_configs:
        - job_name: app
          scrape_interval: 15s
          scrape_timeout: 10s
          metrics_path: /actuator/prometheus
          static_configs:
            - targets:
                - "localhost:${app_port}"

processors:
  resourcedetection:
    detectors: [ecs, env]
    timeout: 5s
    override: false

  transform/promote_ecs_attrs:
    metric_statements:
      - context: resource
        statements:
          - set(attributes["task_id"], Substring(attributes["aws.ecs.task.arn"], LastIndexOf(attributes["aws.ecs.task.arn"], "/") + 1, Len(attributes["aws.ecs.task.arn"]) - LastIndexOf(attributes["aws.ecs.task.arn"], "/") - 1)) where attributes["aws.ecs.task.arn"] != nil
          - set(attributes["container"], attributes["aws.ecs.container.name"]) where attributes["aws.ecs.container.name"] != nil

  batch/metrics:
    send_batch_size: 1000
    send_batch_max_size: 1000
    timeout: 10s

exporters:
  prometheusremotewrite:
    endpoint: ${amp_endpoint}api/v1/remote_write
    auth:
      authenticator: sigv4auth
    resource_to_telemetry_conversion:
      enabled: true
    # Sole source of truth for these labels; the app must not emit them.
    external_labels:
      service: ${service_name}
      env: ${env}
      deployment: ${deployment}
      network: ${network}

service:
  extensions: [sigv4auth, health_check]
  pipelines:
    metrics:
      receivers: [prometheus]
      processors: [resourcedetection, transform/promote_ecs_attrs, batch/metrics]
      exporters: [prometheusremotewrite]
  telemetry:
    logs:
      level: warn
