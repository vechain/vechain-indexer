extensions:
  sigv4auth:
    region: ${aws_region}
    service: aps
  health_check:
    endpoint: 0.0.0.0:13133

receivers:
  prometheus:
    config:
      scrape_configs:
        - job_name: app
          scrape_interval: 15s
          scrape_timeout: 10s
          metrics_path: /actuator/prometheus
          static_configs:
            - targets:
                - "localhost:${app_port}"
  # Emits per-task and per-container cgroup CPU/memory (ecs_task_cpu_*,
  # ecs_task_memory_*, container_cpu_*, container_memory_*). Reads from
  # the ECS task metadata endpoint, so no IAM change; works only on
  # Fargate / EC2 tasks. Cardinality: 2 containers per task (app +
  # sidecar), acceptable at current task counts.
  awsecscontainermetrics:
    collection_interval: 20s

processors:
  resourcedetection:
    detectors: [ecs, env]
    timeout: 5s
    override: false

  # ADOT v0.46 doesn't ship the OTTL `transform` processor, so we use
  # `resource` actions to shape the labels before resource_to_telemetry_conversion
  # promotes them at export time. Extract task_id from the task ARN,
  # rename container name to `container`, and drop everything else the
  # ecs detector + awsecscontainermetrics receiver add. `container.name`
  # is the semconv key the receiver sets; the ecs detector does not emit
  # it, so /actuator/prometheus scrapes get an empty `container` label.
  resource:
    attributes:
      - key: aws.ecs.task.arn
        pattern: ^.+/(?P<task_id>[^/]+)$
        action: extract
      - key: container
        from_attribute: container.name
        action: insert
      - key: aws.ecs.task.arn
        action: delete
      - key: aws.ecs.task.id
        action: delete
      - key: aws.ecs.task.family
        action: delete
      - key: aws.ecs.task.revision
        action: delete
      - key: aws.ecs.task.version
        action: delete
      - key: aws.ecs.task.known_status
        action: delete
      - key: aws.ecs.task.launch_type
        action: delete
      - key: aws.ecs.task.pull_started_at
        action: delete
      - key: aws.ecs.task.pull_stopped_at
        action: delete
      - key: aws.ecs.cluster.arn
        action: delete
      - key: aws.ecs.cluster.name
        action: delete
      - key: aws.ecs.launchtype
        action: delete
      - key: aws.ecs.service.name
        action: delete
      # Upstream ADOT (opentelemetry-collector-contrib) emits this attribute
      # as `know_status` — note the missing trailing `n`. Do not "fix" the
      # key name here; the receiver would then leak the attribute as a
      # label. See receiver/awsecscontainermetricsreceiver/internal/
      # awsecscontainermetrics/constant.go.
      - key: aws.ecs.container.know_status
        action: delete
      - key: aws.ecs.container.created_at
        action: delete
      - key: aws.ecs.container.started_at
        action: delete
      - key: aws.ecs.container.finished_at
        action: delete
      - key: aws.ecs.container.exit_code
        action: delete
      - key: aws.ecs.container.image.id
        action: delete
      - key: aws.ecs.docker.name
        action: delete
      - key: container.name
        action: delete
      - key: container.id
        action: delete
      - key: container.image.name
        action: delete
      - key: container.image.tag
        action: delete
      - key: aws.log.group.names
        action: delete
      - key: aws.log.group.arns
        action: delete
      - key: aws.log.stream.names
        action: delete
      - key: aws.log.stream.arns
        action: delete
      - key: cloud.provider
        action: delete
      - key: cloud.platform
        action: delete
      - key: cloud.region
        action: delete
      - key: cloud.account.id
        action: delete
      - key: cloud.availability_zone
        action: delete
      - key: service.name
        action: delete
      - key: service.instance.id
        action: delete
      - key: service.version
        action: delete

  batch/metrics:
    send_batch_size: 1000
    send_batch_max_size: 1000
    timeout: 10s

exporters:
  prometheusremotewrite:
    endpoint: ${amp_endpoint}api/v1/remote_write
    auth:
      authenticator: sigv4auth
    resource_to_telemetry_conversion:
      enabled: true
    # Sole source of truth for these labels; the app must not emit them.
    external_labels:
      service: ${service_name}
      env: ${env}
      deployment: ${deployment}
      network: ${network}

service:
  extensions: [sigv4auth, health_check]
  pipelines:
    metrics:
      receivers: [prometheus, awsecscontainermetrics]
      processors: [resourcedetection, resource, batch/metrics]
      exporters: [prometheusremotewrite]
  telemetry:
    logs:
      level: warn
