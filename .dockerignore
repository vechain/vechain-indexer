# Ignore everything by default
*

# Gradle wrapper (needed by Dockerfile)
!gradle/
gradle/docker.gradle.properties
!gradlew

# Build config (needed by Dockerfile)
!build.gradle.kts
!settings.gradle.kts
!system.properties
!third_party/

# Source packages shipped in the image (e2e is intentionally omitted)
!packages/api/
!packages/indexer/
!packages/common/

# Exclude test source dirs
packages/**/src/test/

# Exclude build outputs (except pre-built JARs for Dockerfile.prebuilt)
packages/*/build/**
!packages/api/build/libs/**
!packages/indexer/build/libs/**
