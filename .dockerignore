# Ignore everything by default
*

# Gradle wrapper (needed by Dockerfile)
!gradle/
gradle/docker.gradle.properties
!gradlew

# Build config (needed by Dockerfile)
!build.gradle.kts
!settings.gradle.kts
!system.properties
!third_party/

# Source packages shipped in the image (e2e is intentionally omitted)
!packages/api/
!packages/indexer/
!packages/common/

# Exclude inputs the Gradle build never reads, so they stay out of the
# content hash that decides whether an image needs rebuilding
packages/**/src/test/
packages/*/scripts/
packages/*/.env.example*

# Exclude build outputs (except pre-built JARs for Dockerfile.prebuilt)
packages/*/build/**
!packages/api/build/libs/**
!packages/indexer/build/libs/**
