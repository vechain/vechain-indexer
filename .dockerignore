# Ignore everything by default
*

# Gradle wrapper (needed by Dockerfile)
!gradle/
gradle/docker.gradle.properties
!gradlew

# Build config (needed by Dockerfile)
!build.gradle.kts
!settings.gradle.kts
!system.properties
!third_party/

# Source packages (needed by both Dockerfiles)
!packages/

# Exclude test-only package
packages/e2e/

# Exclude test source dirs
packages/**/src/test/

# Exclude build outputs (except pre-built JARs for Dockerfile.prebuilt)
packages/*/build/**
!packages/*/build/libs/**
