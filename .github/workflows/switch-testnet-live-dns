name: Switch Testnet Live Environment

on:
  workflow_dispatch:
  push:
    branches:
     - 'switch-single-dns'
  pull_request: 
    branches: [main]

# Required for authentication through GitHub OIDC
permissions:
  id-token: write # This is required for requesting the JWT
  contents: read # This is required for actions/checkout

jobs:

  identify-live-color:
    name: Identify live color
    uses: ./.github/workflows/identify-live-color.yml
    with:
      dns_record_name: testnet.live.prod.veworld.vechain.org.
      hosted_zone_id: Z074702037Q8JBHKIAYSD
    permissions:
      contents: read
      id-token: write
    secrets: inherit

  fetch-lb-dns-names:
    name: Fetch load balancer DNS names
    runs-on: ubuntu-latest
    permissions:
      id-token: write

    steps:
      - name: Configure AWS credentials
        uses: aws-actions/configure-aws-credentials@v4
        with:
          aws-region: eu-west-1
          role-to-assume: ${{ secrets.PROD_AWS_ACC_ROLE }}

      - name: Get load balancer DNS names
        id: get-lb-dns-names
        run: |
          blue_test_dns=$(aws elbv2 describe-load-balancers --names prod-blue-test-api-veworld-alb --query 'LoadBalancers[0].DNSName' --output text) || 
          { echo "Error: Failed to fetch blue testnet load balancer dns. Please ensure the dead environment is deployed and ready to receive traffic"; exit 1; }
          green_test_dns=$(aws elbv2 describe-load-balancers --names prod-green-test-api-veworld-alb --query 'LoadBalancers[0].DNSName' --output text) || 
          { echo "Error: Failed to fetch green testnet load balancer dns. Please ensure the dead environment is deployed and ready to receive traffic"; exit 1; }
          
          echo "blue_test_dns=$blue_test_dns" >> $GITHUB_OUTPUT
          echo "green_test_dns=$green_test_dns" >> $GITHUB_OUTPUT

    outputs:
      blue_test_dns: ${{ steps.get-lb-dns-names.outputs.blue_test_dns }}
      green_test_dns: ${{ steps.get-lb-dns-names.outputs.green_test_dns }}

  deploy-vpc-stack:
    name: Deploy VPC stack & switch DNS
    runs-on: ubuntu-latest

    defaults:
      run:
        working-directory: terraform/vpc

    needs: [fetch-lb-dns-names, identify-live-color]
    env:
      environment: prod

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Log Switching Details
        run: |
          echo "Current live color: ${{ needs.identify-live-color.outputs.live_color }}"
          echo "New live color: ${{ needs.identify-live-color.outputs.dead_color }}"
          echo "Preparing to switch live environment from ${{ needs.identify-live-color.outputs.live_color }} to ${{ needs.identify-live-color.outputs.dead_color }}"

      - name: Configure AWS credentials
        uses: aws-actions/configure-aws-credentials@v4
        with:
            aws-region: eu-west-1
            role-to-assume: ${{ secrets.PROD_AWS_ACC_ROLE }}

      - name: Check Dead ENV is Ready
        id: check-dead-env-is-ready
        run: |
          cluster_services=$(aws ecs list-services --cluster ${{ needs.identify-live-color.outputs.dead_color }}-veworld-cluster --query 'length(serviceArns)' --output text)
          if (( $cluster_services > 0 )); then
            echo "env_ready=true" >> $GITHUB_OUTPUT
            echo "The ${{ needs.identify-live-color.outputs.dead_color }} cluster is ready, proceeding with deployment"
          else
            echo "env_ready=false" >> $GITHUB_OUTPUT
            echo "The ${{ needs.identify-live-color.outputs.dead_color }} cluster has no services running. Please ensure the environment is ready for traffic"
            exit 0
          fi

      # Required for Terraform to source modules from other vechain repositories
      - name: Set up SSH agent
        uses: webfactory/ssh-agent@v0.8.0
        with:
          ssh-private-key: ${{ secrets.VECHAINCI_SSH_PRIVATE_KEYS }}

      - name: Point backend to correct environment
        id: specify-backend
        run: |
          sed -i "s/{{{ENV}}}/${{ env.environment }}/g" provider.tf
        continue-on-error: false

      - name: Setup Terraform
        uses: hashicorp/setup-terraform@v2
        with:
          terraform_version: 1.7.3
          terraform_wrapper: true

      - name: Terraform Initialize
        id: init
        run: terraform init

      - name: Terraform Workspace
        id: workspace
        run: terraform workspace select ${{ env.environment }}

      - name: Terraform Validate
        id: validate
        run: terraform validate

      - name: Terraform Plan
        id: plan
        if: steps.check-dead-env-is-ready.outputs.env_ready == 'true'
        run: terraform plan -out "apply.plan" --var=live_color=${{ needs.identify-live-color.outputs.dead_color }}

     # - name: Terraform Apply
      #  if: steps.check-dead-env-is-ready.outputs.env_ready == 'true'
      #  id: apply
      #  run: terraform apply "apply.plan"
